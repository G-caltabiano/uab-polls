[Unit]
Description=Disponibilitat Medicina UAB
After=network-online.target

[Service]
Type=simple
UMask=0077
WorkingDirectory=/home/gian/UAB-Polls
Environment=UAB_POLLS_DATA_DIR=/home/gian/UAB-Polls/data
Environment=UAB_POLLS_ROOT_PATH=/horario/enquestes
Environment=UAB_POLLS_INITIAL_ADMIN_EMAIL=gianluigi.caltabiano@uab.cat
Environment=UAB_POLLS_EMAIL_PROVIDER=gog
Environment=UAB_POLLS_GOG_PATH=/home/gian/.local/bin/gog
Environment=UAB_POLLS_GOG_ACCOUNT=fridaygc.bot@gmail.com
ExecStart=/home/gian/UAB-Polls/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8096 --proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/gian/UAB-Polls/data

[Install]
WantedBy=default.target
